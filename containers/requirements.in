# BabelBrain runtime environment for the MSI (Linux x86_64, NVIDIA A100/H100) Apptainer image.
#
# Python 3.12. Upstream main now uses Python 3.12 syntax (PEP 701 f-strings), so 3.11 can't
# import it. Basis: upstream ProteusMRIgHIFU/BabelBrain main @ 29b1026, environment_win-314.yml
# (upstream's CUDA environment for modern Python: NumPy 2.3.5 with CuPy 13.6.0), plus PySide6
# 6.9.3 from environment_mac_*-314.yml. Conda packages are mapped to PyPI wheels.
# Deliberate differences from those files are marked "DIFF" and listed in README.md.
# Edit this file, then regenerate requirements.lock.txt (see README.md) and rebuild the image.

# --- numerics and GPU ---
numpy==2.3.5
scipy==1.17.1
numba==0.65.0
llvmlite                 # whatever numba 0.65.0 requires
# DIFF: CUDA 12.9 wheels (cupy-cuda12x) from the nvidia/cuda base image, not conda's CUDA build.
# Agate's driver is 580.x (CUDA <= 13.0).
cupy-cuda12x==13.6.0
fastrlock
setuptools<81            # BabelViscoFDTD 1.2.7 backends import distutils (gone in Python 3.12); setuptools provides the shim

# --- solver ---
# DIFF: 1.2.7, not upstream main's 1.2.6: it matches UserTx, UserTxServerMode and dualTx and the existing MSI environment.
babelviscofdtd==1.2.7

