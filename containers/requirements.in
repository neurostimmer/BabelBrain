# BabelBrain runtime environment for the MSI (Linux x86_64, NVIDIA A100/H100) Apptainer image.
#
# Basis: upstream ProteusMRIgHIFU/BabelBrain, branch UserTxServerMode @ f973f5d,
# file environment_linux_cuda_13_driver_580.yml (Python 3.11.14). Its pip section is copied
# verbatim below; its conda-only packages are mapped to PyPI wheels in the first block.
# Deliberate differences from that file are marked "DIFF" and listed in README.md.
# Edit this file, then regenerate requirements.lock.txt (see README.md) and rebuild the image.

# --- conda section of the upstream file, as PyPI wheels ---
numpy==1.26.4
scipy==1.16.3
numba==0.63.1
llvmlite==0.46.0
fastrlock==0.8.3
# DIFF: CUDA 12.9 (from the nvidia/cuda base image) instead of conda cuda 13.1; same CuPy release.
# Agate's driver is 580.x (CUDA <= 13.0). CuPy 14 would need NumPy 2, which upstream's pins exclude.
cupy-cuda12x==13.6.0
setuptools<81            # BabelViscoFDTD / old packages still import pkg_resources or distutils shims
# DIFF: mkl / mkl_fft not installed; BabelBrain falls back to numpy.fft when mkl_fft is missing.

