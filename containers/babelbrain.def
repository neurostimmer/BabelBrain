Bootstrap: docker
From: nvidia/cuda:12.9.1-base-ubuntu22.04

# BabelBrain runtime environment for headless GPU runs (Apptainer). Environment only:
# the BabelBrain code is NOT in the image. bb-run.sh checks out a ref of the fork at run
# time and puts it on PYTHONPATH, so a new code version needs no rebuild.
#
# Build (see build.sbatch and README.md), from this directory:
#   apptainer build --fakeroot babelbrain_env.sif babelbrain.def
#
# CUDA 12.9 user-space libraries; needs an NVIDIA driver >= 575 (agate: 580.x).
# Python 3.12 + pinned wheels from requirements.lock.txt (basis: upstream main
# environment_win-314.yml, NumPy 2.3.5 + CuPy 13.6.0; see requirements.in).

%files
    requirements.in        /opt/bb/env/requirements.in
    requirements.lock.txt  /opt/bb/env/requirements.lock.txt
    deps_allow.txt         /opt/bb/env/deps_allow.txt
    bb-entry.sh            /opt/bb/bin/bb-entry
    depcheck.py            /opt/bb/bin/depcheck.py
    smoke_test.py          /opt/bb/bin/smoke_test.py

%labels
    org.opencontainers.image.title BabelBrain runtime environment (headless, CUDA)
    org.opencontainers.image.source https://github.com/neurostimmer/BabelBrain
    bb.base nvidia/cuda:12.9.1-base-ubuntu22.04
    bb.cuda 12.9
    bb.python 3.12
    bb.babelviscofdtd 1.2.7
    bb.env_basis upstream main@29b1026 environment_win-314.yml (+ PySide6 6.9.3 from environment_mac_*-314.yml)
    bb.env_basis_sha256 b759d71aa8c45b6084f8999e07a65e85a53d79304c93219399c29785a6f2281f

%environment
    export LC_ALL=C.UTF-8 LANG=C.UTF-8
    export PATH=/opt/bb/venv/bin:/opt/bb/bin:/usr/local/cuda/bin:$PATH
    export CUDA_PATH=/usr/local/cuda
    # Headless defaults: no display anywhere on MSI.
    export QT_QPA_PLATFORM=offscreen
    export MPLBACKEND=Agg
    export PYVISTA_OFF_SCREEN=true
    export BABEL_NO_PLOTS=1
    # BabelBrain's opt-out switch for its usage telemetry (BabelBrain/Telemetry/Telemetry.py).
    export MYAPP_DISABLE_TELEMETRY=1
    export PYTHONNOUSERSITE=1
    export OCL_ICD_VENDORS=/etc/OpenCL/vendors

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    CUDA_PKG=12-9

    # System libraries: git (code checkout), Qt6/VTK runtime deps for the offscreen Qt
    # platform and Mesa software OpenGL (VTK windows under Qt offscreen or xvfb-run),
    # OpenCL ICD loader, and CUDA 12.9 user-space libraries + headers for NVRTC.
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git git-lfs openssh-client procps file util-linux xz-utils \
        libgomp1 libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 fonts-dejavu-core \
        libgl1 libegl1 libopengl0 libglx-mesa0 libegl-mesa0 libgl1-mesa-dri libosmesa6 libglu1-mesa \
        libx11-6 libx11-xcb1 libxext6 libxrender1 libxi6 libxrandr2 libxfixes3 libxcursor1 \
        libxcomposite1 libxdamage1 libxtst6 libxt6 libsm6 libice6 libxkbcommon0 libxkbcommon-x11-0 \
        libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libxcb-glx0 libxcb-xfixes0 \
        libnss3 libasound2 libpulse0 xvfb xauth \
        ocl-icd-libopencl1 clinfo \
        cuda-nvrtc-${CUDA_PKG} cuda-nvrtc-dev-${CUDA_PKG} cuda-cudart-dev-${CUDA_PKG} cuda-cccl-${CUDA_PKG} \
        libcublas-${CUDA_PKG} libcufft-${CUDA_PKG} libcurand-${CUDA_PKG} \
        libcusolver-${CUDA_PKG} libcusparse-${CUDA_PKG} libnvjitlink-${CUDA_PKG}
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # OpenCL: apptainer --nv binds libnvidia-opencl.so.1 from the host; register it.
    mkdir -p /etc/OpenCL/vendors
    echo libnvidia-opencl.so.1 > /etc/OpenCL/vendors/nvidia.icd

    # Python 3.12 (python-build-standalone via uv) and the locked wheel set.
    export UV_INSTALL_DIR=/opt/uv/bin UV_NO_MODIFY_PATH=1
    curl -LsSf https://astral.sh/uv/0.11.21/install.sh | sh
    export PATH=/opt/uv/bin:$PATH
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_CACHE_DIR=/tmp/uv-cache UV_LINK_MODE=copy
    uv python install 3.12.13 || uv python install 3.12
    uv venv --python 3.12 /opt/bb/venv
    uv pip install --python /opt/bb/venv/bin/python --no-build --require-hashes \
        -r /opt/bb/env/requirements.lock.txt
    rm -rf /tmp/uv-cache
    chmod 755 /opt/bb/bin/bb-entry /opt/bb/bin/depcheck.py /opt/bb/bin/smoke_test.py

    # Build-time import check (no GPU here) and provenance record.
    export QT_QPA_PLATFORM=offscreen MPLBACKEND=Agg CUDA_PATH=/usr/local/cuda
    /opt/bb/venv/bin/python - <<'PY'
import importlib, importlib.metadata as md, json, platform, hashlib
mods = ["numpy", "scipy", "h5py", "nibabel", "SimpleITK", "skimage", "pandas", "matplotlib",
        "trimesh", "pymeshfix", "pyvista", "vtk", "pyvistaqt", "PySide6.QtWidgets", "superqt",
        "pyopencl", "cupy", "numba", "pydicom", "jinja2", "yaml", "BabelViscoFDTD"]
for m in mods:
    importlib.import_module(m)
from PySide6.QtWidgets import QApplication
app = QApplication([])
# Offscreen OpenGL (Mesa) check in a child process: a GL failure is recorded, not fatal.
import subprocess, sys
gl_code = ("import vtk; rw = vtk.vtkRenderWindow(); rw.SetOffScreenRendering(1); rw.Render(); "
           "print(rw.GetClassName(), '|', ' '.join(rw.ReportCapabilities().split()[:12]))")
r = subprocess.run([sys.executable, "-c", gl_code], capture_output=True, text=True, timeout=120)
gl = (r.stdout.strip() or r.stderr.strip()[-300:]) + f" (exit {r.returncode})"
sha = lambda p: hashlib.sha256(open(p, "rb").read()).hexdigest()
info = dict(python=platform.python_version(),
            babelviscofdtd=md.version("babelviscofdtd"), cupy=md.version("cupy-cuda12x"),
            numpy=md.version("numpy"), pyside6=md.version("pyside6"), vtk=md.version("vtk"),
            requirements_in_sha256=sha("/opt/bb/env/requirements.in"),
            requirements_lock_sha256=sha("/opt/bb/env/requirements.lock.txt"),
            vtk_offscreen_gl=gl)
json.dump(info, open("/opt/bb/BUILD_INFO.json", "w"), indent=1)
print(json.dumps(info, indent=1))
PY
    uv pip freeze --python /opt/bb/venv/bin/python > /opt/bb/env/installed.txt
    date -u +%Y-%m-%dT%H:%M:%SZ > /opt/bb/BUILD_DATE
    echo "bb.requirements_lock_sha256 $(sha256sum /opt/bb/env/requirements.lock.txt | cut -d' ' -f1)" >> "$APPTAINER_LABELS"
    echo "bb.requirements_in_sha256 $(sha256sum /opt/bb/env/requirements.in | cut -d' ' -f1)" >> "$APPTAINER_LABELS"
    echo "bb.python_full $(/opt/bb/venv/bin/python -c 'import platform; print(platform.python_version())')" >> "$APPTAINER_LABELS"
    echo "bb.build_date $(cat /opt/bb/BUILD_DATE)" >> "$APPTAINER_LABELS"

%runscript
    exec /opt/bb/bin/bb-entry "$@"

%test
    /opt/bb/venv/bin/python -c 'import BabelViscoFDTD, cupy, PySide6, vtk; print("bb env imports OK")'

%help
    BabelBrain runtime environment (no BabelBrain code inside). Use bb-run.sh from the
    recipe directory, which checks out the requested ref and runs:
        apptainer run --nv <image> <command ...>
    Inside, /opt/bb/bin/bb-entry sets PYTHONPATH to the checkout given by BB_SRC, prints
    provenance (commit SHA, image labels, versions), runs depcheck.py, then execs the command.
    Files: /opt/bb/env/requirements.lock.txt (pins), /opt/bb/env/installed.txt, /opt/bb/BUILD_INFO.json.
